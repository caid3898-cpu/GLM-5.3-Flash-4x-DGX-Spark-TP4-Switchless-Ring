# GLM-5.3-Flash TP4 环网（switchless）配置
# 拓扑核对（2026-10-05 实测）：
#   ring rank0=bf94  rank1=0167  rank2=6e8e  rank3=bfe5
#   每节点 f0 连下一个 rank 的 f1，f1 接受上一个 rank 的 f0 —— 与文档要求的环接法一致
#   /30 每条电缆落在各自不同的 /24，故 SWITCHLESS_SUBNET_PREFIX_LEN=24 可正确区分每条线
#   16 个设备的 GID index 3 全部为 IPv4-mapped RoCEv2（NCCL_IB_GID_INDEX=3 成立）
#   IB_HCA 只列**朝向两个邻居**的两个口（都在 PCIe root 0000），
#   不用 dual-pci-domain 的四口方案 —— 我们编的补丁版只发布 2 个 listener GID。

# ---- 环序（四台，必须按 rank 顺序）----
HOSTS="spark-bf94 spark-0167 spark-6e8e spark-bfe5"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"
# bootstrap 用管理网（enP7s7）
IPS="192.168.31.21 192.168.31.31 192.168.31.28 192.168.31.13"
FABRIC_IFACE=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1

# ---- 补丁版 NCCL（本机自编，sparkring switchless-cycle）----
NCCL_HOST_DIR=/home/dada/nccl-2.30.7-dual
SWITCHLESS_NCCL_SHA256=9ddd77c2734234dbbbd784d0da8666b3abe14cf00ce6467fe9bafd6e62f80274
# RoCE 环网地址段（不是 bootstrap 管理段）
SWITCHLESS_ADDR_RANGE=10.200.0.0/16
SWITCHLESS_SUBNET_PREFIX_LEN=24
NCCL_IB_GID_INDEX=3

TRANSPORT=switchless

# ---- 模型与镜像 ----
IMAGE=glm53-roce:v11-b58f34ea
MESH_ROCE=0
MODEL_DIR="$HOME/models/glm-quant-mix/lossless8"
DRAFT_DIR="$HOME/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk"
CTN=glm53-ring-tp4
OVERLAY_REMOTE="$HOME/glm53-ring-tp4-overlay"
source profiles/current.env
# 试试点新增参数（追加到 .env.switchless 副本 → .env.switchless.hicache）
# CPU 暂存层故意只有 128MiB（~19k tokens/rank），让 120k 测试提示的大部分块被降级到 fs 磁盘层，
# 重启后恢复效果才看得清。正式采用时再调大（如 4-8GiB，注意宿主内存预算，2026-10-08 OOM 事件后须保守）。
EXTRA_ARGS='--enable-cumem-allocator --kv-offloading-size 0.125 --kv-transfer-config "{\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\"kv_connector_extra_config\":{\"spec_name\":\"TieringOffloadingSpec\",\"secondary_tiers\":[{\"type\":\"fs\",\"root_dir\":\"/home/dada/glm53-kv-offload\"}]}}"'
EXTRA_ENV='PYTHONHASHSEED=0'
