{
 "title": "GLM-5.3-Flash TP4 环网 · vLLM 实时面板",
 "uid": "glm53-tp4-vllm",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "解码吞吐 (tok/s)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "toks",
     "decimals": 1
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Prefill 吞吐 (tok/s)",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:prompt_tokens_total[1m]))",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "toks",
     "decimals": 0
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "在跑请求",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "vllm:num_requests_running",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "排队请求",
   "gridPos": {
    "x": 11,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "vllm:num_requests_waiting",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "KV 池占用",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "vllm:kv_cache_usage_perc * 100",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "steps": [
       {
        "color": "green"
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "前缀缓存命中",
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:prefix_cache_hits_total[5m])) / sum(rate(vllm:prefix_cache_queries_total[5m])) * 100",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "单请求解码速度 (tok/s, 平均)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "rate(vllm:request_time_per_output_token_seconds_count[5m]) / rate(vllm:request_time_per_output_token_seconds_sum[5m])",
     "refId": "A",
     "legendFormat": "avg"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "toks",
     "decimals": 1
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "TTFT (秒)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "refId": "A",
     "legendFormat": "p50"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "refId": "B",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "请求数 (running / waiting)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "vllm:num_requests_running",
     "refId": "A",
     "legendFormat": "running"
    },
    {
     "expr": "vllm:num_requests_waiting",
     "refId": "B",
     "legendFormat": "waiting"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "投机解码接受长度",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "1 + sum(rate(vllm:spec_decode_num_accepted_tokens_total[5m])) / sum(rate(vllm:spec_decode_num_draft_tokens_total[5m]))",
     "refId": "A",
     "legendFormat": "accept len"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "KV 池占用 (%)",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "vllm:kv_cache_usage_perc * 100",
     "refId": "A",
     "legendFormat": "kv usage %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "前缀缓存命中率",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:prefix_cache_hits_total[5m])) / sum(rate(vllm:prefix_cache_queries_total[5m])) * 100",
     "refId": "A",
     "legendFormat": "hit %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1
    }
   }
  },
  {
   "id": 30,
   "type": "stat",
   "title": "累计输入缓存命中（亿 tokens）",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "glm_lifetime_cached_tokens / 100000000",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix:亿",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 31,
   "type": "stat",
   "title": "累计输入未命中·重算（亿 tokens）",
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "(glm_lifetime_prompt_tokens - glm_lifetime_cached_tokens) / 100000000",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix:亿",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     }
    },
    "overrides": []
   },
   "options": {
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 32,
   "type": "stat",
   "title": "累计输出（亿 tokens）",
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "uid": "Prometheus"
   },
   "targets": [
    {
     "expr": "glm_lifetime_generation_tokens / 100000000",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix:亿",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  }
 ]
}